+      // Child IPC can disconnect before the process emits its exit event.
+      // The child listeners below provide the concrete failure; the existing
+      // startup deadline still bounds a live child with a lost channel.
+      if (error instanceof Error && error.message === 'authority IPC disconnected') return new Promise(() => {});
+      throw error;
+    });
+    await Promise.race([readiness, deadline, ...exited]);
+  } finally {
+    if (timer !== null) clearTimeout(timer);
+    for (const { child, onExit, onError } of childListeners) {
+      child.removeListener('exit', onExit);
+      child.removeListener('error', onError);
+    }
+  }
+}
