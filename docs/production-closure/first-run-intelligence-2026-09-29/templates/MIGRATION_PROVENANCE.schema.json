{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Covert Migration Candidate",
  "type": "object",
  "required": ["source_provider","source_type","source_reference","candidate_kind","review_state","retention_scope","sensitivity_class"],
  "properties": {
    "source_provider": {"type":"string"},
    "source_type": {"type":"string"},
    "source_reference": {"type":"string","description":"Opaque connector ID or local export digest/path reference; never a credential."},
    "candidate_kind": {"enum":["PREFERENCE","PROJECT_FACT","DECISION","WORKFLOW","RESOURCE","CONVERSATION_REFERENCE"]},
    "confidence": {"type":"number","minimum":0,"maximum":1},
    "review_state": {"enum":["PENDING","ACCEPTED","EDITED","REJECTED"]},
    "retention_scope": {"enum":["SESSION","PROJECT","OPERATOR"]},
    "sensitivity_class": {"enum":["NORMAL","PRIVATE","SENSITIVE","SECRET_EXCLUDE"]}
  }
}
